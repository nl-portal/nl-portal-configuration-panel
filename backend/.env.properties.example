# Local development config for `./gradlew bootRun` (RUN_MODE=sources).
# Copy to `.env.properties` (gitignored) and adjust for your machine.
# Unlike imports/backend.env, which configures the containerised backend under the
# compose local/remote modes, this file uses host ports: the panel database on 54322,
# Keycloak on 8083 and NL Portal on 8080.

SERVER_PORT=8090
LOGLEVEL=INFO

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:54322/nl-portal-config
DATABASE_USERNAME=config
DATABASE_PASSWORD=password

# --- Keycloak ---
JWKS_URI=http://localhost:8083/auth/realms/nlportalconfig/protocol/openid-connect/certs

# --- Config server ---
CONFIG_CACHE_TTL=30000
CONFIG_SERVER_PREFIX=/configuration
CONFIG_SERVER_TOKEN=VerySecretToken

# --- Notify NL Portal on change (actuator refresh/restart) ---
CONFIG_NOTIFY_ENABLED=true
CONFIG_NOTIFY_LIST=http://localhost:8080/
