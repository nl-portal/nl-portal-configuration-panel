# Configures the containerised panel frontend (RUN_MODE=local/remote). These URLs are used by the browser.
OIDC_URL="http://localhost:8083/auth/realms/nlportalconfig"
OIDC_CLIENT_ID="nl-portal-config"
OIDC_REDIRECT_URL="http://localhost:3001"
OIDC_POST_LOGOUT_REDIRECT_URL="http://localhost:3001"
# NL Portal's own application name; configuration is stored per application.
CLIENT_APPLICATION_NAME="nl-portal-app"
CONFIG_PANEL_REST_API_URL="http://localhost:8090/api"
