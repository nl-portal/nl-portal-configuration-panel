# Configures the containerised panel backend (RUN_MODE=local/remote).
LOGLEVEL=INFO
SERVER_PORT=8090
DATABASE_URL=jdbc:postgresql://localhost:5432/nl-portal-config
DATABASE_USERNAME=config
DATABASE_PASSWORD=password
JWKS_URI=http://localhost:8083/auth/realms/nlportalconfig/protocol/openid-connect/certs
CONFIG_SECURITY_JWT_AUTHORITIES_CLAIM_NAME=['realm_access']['roles']
CONFIG_SECURITY_API_AUTHORITIES=ROLE_CONFIG_PANEL_ADMIN
CONFIG_CACHE_TTL=30000
CONFIG_SERVER_PREFIX=/configuration
CONFIG_SERVER_TOKEN=VerySecretToken
CONFIG_NOTIFY_ENABLED=true
# NL Portal backend, once it joined this network (NETWORK=configuration-panel). Without it, notify logs a WARN.
CONFIG_NOTIFY_LIST=http://nl-portal:8080
CONFIG_NOTIFY_CLIENT_TOKEN_URI=http://localhost:8083/auth/realms/nlportalconfig/protocol/openid-connect/token
CONFIG_NOTIFY_CLIENT_ID=nl-portal-m2m
CONFIG_NOTIFY_CLIENT_SECRET=NKanOAqgkvWOJivbt2qhiOePDbmznN8t
CONFIG_ENCRYPTION_KEY=Y8rYHmKNxosmhptYb4KqYQW8anVo9oGLHHXq9AGVk8o=
